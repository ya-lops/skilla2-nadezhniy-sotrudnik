---
import BaseLayout from "@/layouts/BaseLayout.astro";
import KP from "@/components/sections/KP.astro";
import Breadcrumbs from "@/components/ui/Breadcrumbs.astro";
import Blog from "@/components/sections/Blog.astro";

import { getBrandData } from "@/lib/api";

const { blogpost } = Astro.params;

const brandData = await getBrandData();

const article = brandData.blogs?.find((b) => b.url === blogpost);

if (!article) {
  return Astro.rewrite("/404");
}
---

<BaseLayout
  {brandData}
  metaTitle={article.meta_title || article.title}
  metaDescription={article.meta_description || article.subtitle || ''}
  metaKeywords={article.meta_keywords || ''}
>
  <Breadcrumbs
    items={[
      { label: "Главная", href: "/" },
      { label: "Блог", href: "/blog" },
      { label: article.title },
    ]}
  />

  <article 
    class="blogpost py-8 md:py-10 lg:py-20" 
    data-page="blogpost"
    itemscope 
    itemtype="https://schema.org/BlogPosting"
  >
    <meta itemprop="datePublished" content={article.date_create} />
    <meta itemprop="url" content={`/blog/${article.url}`} />
    {article.cover && <meta itemprop="image" content={article.cover} />}
    
    <div class="container">
      <div class="_blogpost-inner max-w-[57.5rem] mx-auto">
        <time class="_blogpost-date typo-label text-text-tertiary block mb-3" datetime={article.date_create} itemprop="datePublished">
          {article.date_create}
        </time>

        <h1 class="_blogpost-title typo-h2 mb-8" itemprop="name">{article.title}</h1>

        {article.cover && (
          <img 
            src={article.cover} 
            alt={article.title}
            class="rounded-3xl w-full"
            itemprop="image"
          />
        )}

        <div class="_blogpost-content prose max-w-none" set:html={article.content} itemprop="articleBody" />
      </div>
    </div>
  </article>

  <Blog {brandData} showLast />

  <KP {brandData} />
</BaseLayout>

<style is:global>
  @reference "@/styles/global.css";

  [data-page="blogpost"] {
    & :where(h1, h2, h3, h4, h5, h6, ul, ol, img):not(._blogpost-title) {
      @apply mt-8 lg:mt-15;
    }

    & p {
      @apply max-w-[45.625rem] mt-6 font-normal;
    }

    & img {
      @apply rounded-3xl;
    }

    & :where(ol, ul) {
      @apply list-inside mt-4;

      li {
        @apply mt-2 text-text-secondary;
      }
    }

    & ol {
      @apply list-decimal;
    }

    & ul {
      @apply list-disc;
    }
  }
</style>