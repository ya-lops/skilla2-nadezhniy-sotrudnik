---
import { getDiscountedPrice, getDiscountPercent, hasDiscount } from "@/utils/price";
import IconSvg from "../IconSvg.astro";

interface Props {
  brandData: any;
}

const { brandData } = Astro.props;

const discount = getDiscountPercent(brandData.main.adv_price_percent);

const advantages = [
  {
    name: "Экспертность в области",
    checked: true,
  },
  {
    name: "Сезонность/проектность",
    checked: false,
  },
  {
    name: "Экономия на содержание сотрудников",
    checked: false,
  },
  {
    name: "Белая экономия на налогах",
    checked: false,
  },
  {
    name: "Экономия на НДС",
    checked: false,
  },
  {
    name: "Отсутствие рисков кассового разрыва",
    checked: false,
  },
];
---

<section class="py-8 md:py-10 lg:py-25 mx-2 lg:mx-5 rounded-[20px] md:rounded-[40px] bg-[#2B2B35]" data-cmp="Advantages">
  <div class="container">
    <h2 class="typo-h3 uppercase mb-8 md:12 lg:mb-16 text-text-primary-inverse text-center">Преимущества аутсорса</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-20">
      <div class="text-text-primary-inverse">
        <h3 class="typo-h5 text-center mb-10 text-text-primary-inverse">Аутсорс</h3>
        <div class="flex flex-col gap-2.5">
          {
            advantages?.map((advantage: any) => (
              <div class="flex items-center gap-6 lg:gap-10 p-4 lg:p-7 rounded-3xl bg-[#1E1E26]">
                <div class="flex items-center justify-center">
                  <svg width="55" height="55" viewBox="0 0 55 55" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="55" height="55" rx="27.5" fill="#FFE063" />
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M40.0241 18.226C40.6587 18.8606 40.6587 19.8894 40.0241 20.524L24.9231 35.625C23.6539 36.8942 21.5961 36.8942 20.3269 35.625L13.351 28.649C12.7163 28.0144 12.7163 26.9856 13.351 26.351C13.9856 25.7164 15.0144 25.7164 15.649 26.351L22.625 33.3269L37.726 18.226C38.3606 17.5913 39.3895 17.5913 40.0241 18.226Z"
                      fill="#FF802F"
                    />
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M40.0241 18.226C40.6587 18.8606 40.6587 19.8894 40.0241 20.524L24.9231 35.625C23.6539 36.8942 21.5961 36.8942 20.3269 35.625L13.351 28.649C12.7163 28.0144 12.7163 26.9856 13.351 26.351C13.9856 25.7164 15.0144 25.7164 15.649 26.351L22.625 33.3269L37.726 18.226C38.3606 17.5913 39.3895 17.5913 40.0241 18.226Z"
                      fill="#2B2B35"
                    />
                  </svg>
                </div>

                <p class="typo-t2">{advantage.name}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="">
        <h3 class="typo-h5 text-center mb-10 text-text-primary-inverse">Штатные сотрудники</h3>
        <div class="flex flex-col gap-2.5">
          {
            advantages?.map((advantage: any) => (
              <div
                class={`flex items-center gap-6 lg:gap-10 p-4 lg:p-7 rounded-3xl ${advantage.checked ? "bg-[#1E1E26] text-text-primary-inverse" : "text-text-primary-inverse"}`}
              >
                <div class="flex items-center justify-center rounded-full text-text-primary-inverse">
                  {advantage.checked ? (
                    <svg width="55" height="55" viewBox="0 0 55 55" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect width="55" height="55" rx="27.5" fill="#FFE063" />
                      <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M40.0241 18.226C40.6587 18.8606 40.6587 19.8894 40.0241 20.524L24.9231 35.625C23.6539 36.8942 21.5961 36.8942 20.3269 35.625L13.351 28.649C12.7163 28.0144 12.7163 26.9856 13.351 26.351C13.9856 25.7164 15.0144 25.7164 15.649 26.351L22.625 33.3269L37.726 18.226C38.3606 17.5913 39.3895 17.5913 40.0241 18.226Z"
                        fill="#FF802F"
                      />
                      <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M40.0241 18.226C40.6587 18.8606 40.6587 19.8894 40.0241 20.524L24.9231 35.625C23.6539 36.8942 21.5961 36.8942 20.3269 35.625L13.351 28.649C12.7163 28.0144 12.7163 26.9856 13.351 26.351C13.9856 25.7164 15.0144 25.7164 15.649 26.351L22.625 33.3269L37.726 18.226C38.3606 17.5913 39.3895 17.5913 40.0241 18.226Z"
                        fill="#2B2B35"
                      />
                    </svg>
                  ) : (
                    <svg xmlns="http://www.w3.org/2000/svg" width="55" height="55" viewBox="0 0 24 24" class="opacity-50">
                      <path d="M0 0h24v24H0z" fill="none" />
                      <path
                        fill="currentColor"
                        fill-rule="evenodd"
                        d="M12 18.5A6.5 6.5 0 0 1 6.93 7.931l9.139 9.138A6.47 6.47 0 0 1 12 18.5m5.123-2.498a6.5 6.5 0 0 0-9.124-9.124zM4 12a8 8 0 1 1 16 0a8 8 0 0 1-16 0"
                        clip-rule="evenodd"
                      />
                    </svg>
                  )}
                </div>

                <p class="typo-t2 text-text-tertiary-inverse">{advantage.name}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
