---
import type { BrandData } from "@/types/brand";

import { STORAGE_PATH } from "@/lib/consts";

interface Props {
  brandData: BrandData;
  full?: boolean;
}

const { brandData, full = false } = Astro.props;

// Объединяем все логотипы в один массив
const allPartnersLogos = [...brandData.partners.default_logos, ...(brandData.partners.additional_logos || [])];
---

<section class="py-8 md:py-10 lg:py-25" data-cmp="Partners">
  <div class="container">
    {full && <h2 class="typo-h3 mb-8 md:12 lg:mb-14 uppercase text-center">Наши клиенты</h2>}

    <div
      class:list={[
        full
          ? "grid grid-cols-[repeat(auto-fill,minmax(120px,1fr))] lg:grid-cols-4 gap-6"
          : "flex flex-wrap justify-center gap-4 text-balance",
      ]}
    >
      {
        allPartnersLogos.map((logo: any) => (
          <div
            class:list={[
              "inline-flex items-center justify-center",
              full ? "h-25 lg:h-50 w-full rounded-2xl bg-[#F0F4F9]" : "shrink-0 max-h-8 lg:max-h-[75px] max-w-[156px]",
            ]}
          >
            <img
              class:list={[
                "h-full w-full object-contain pointer-events-none max-w-[75%] max-h-[75%]",
                full ? "max-w-[35%] max-h-[35%]" : "",
              ]}
              src={`${STORAGE_PATH}${logo}`}
              alt={`Логотип партнера нашей компании`}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
