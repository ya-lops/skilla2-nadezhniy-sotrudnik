---
import type { BrandData } from "@/types/brand";
import KpForm from "../blocks/KpForm.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;
---

<section id="kp" class="scroll-mt-25 m-2 lg:m-5 rounded-[20px] md:rounded-[40px] bg-kp-surface overflow-clip" data-cmp="KP">
  <div class="container">
    <div class="grid grid-cols-1">
      <div class="py-10 lg:py-25">
        <h2 class="typo-h3 mb-6 uppercase text-center text-kp-text text-balance">Бесплатно сделаем коммерческое предложение</h2>
        <p class="typo-t2 text-center text-text-secondary">Индивидуально под ваши потребности</p>
        <div class="mt-15 lg:mt-25">
          <KpForm />
        </div>
      </div>
    </div>
  </div>
</section>
