---
import type { BrandData } from "@/types/brand";

import BlockMessengersLinks from "../blocks/BlockMessengersLinks.astro";
import Button from "@/components/ui/Button.astro";
import MobileNav from "@/components/blocks/MobileNav.astro";
import SiteHeaderLogoSvg from "../blocks/SiteHeaderLogoSvg.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;

const firstServiceUrl = brandData.services[0].url.toLowerCase();
const serviceUrls = brandData.services.map((s) => s.url.toLowerCase());
const currentPath = Astro.url.pathname;

const isDarkPage = currentPath === "/" || currentPath === "/about";
const isServicePage = serviceUrls.some((url) => currentPath === `/${url}` || currentPath === `/${url}/`);

const links = [
  { href: `/${firstServiceUrl}`, label: "Услуги и цены", active: isServicePage },
  { href: "/about", label: "О компании", active: currentPath.includes("/about") },
  { href: "/blog", label: "Блог", active: currentPath.includes("/blog") },
  { href: "/contacts", label: "Контакты", active: currentPath.includes("/contacts") },
];
---
<div
  x-data="{ mobileNavOpen: false, stuck: false }"
  x-init="window.addEventListener('scroll', () => { stuck = window.scrollY > 50 })"
  class="sticky top-0 z-5"
  data-cmp="SiteHeader"
>
  <header
    class="transition-all duration-300 border-b border-b-transparent"
    class:list={[isDarkPage ? "text-text-primary-inverse" : "text-text-primary"]}
    :class="stuck ? 'bg-white border-b-outline! text-text-primary!' : 'bg-header-surface'"
  >
    <div class="mx-6 md:mx-20">
      <div class="flex items-center justify-between gap-4 lg:gap-20 py-4 lg:py-6">
        <div class="_header-logo">
          <a href="/" class:list={[isDarkPage ? "text-white" : "text-black"]} :class="stuck ? 'text-black!' : ''">
            <SiteHeaderLogoSvg/>
          </a>
        </div>

        <div class="hidden lg:contents">
          <nav aria-label="Основная навигация">
            <ul class="flex items-center gap-8">
              {
                links.map(({ href, label, active }) => (
                  <li>
                    <a
                      href={href}
                      class:list={[
                        "flex items-center no-underline p-3 rounded-full font-bold",
                        { "text-accent": active, " hover:text-accent": !active },
                      ]}
                      aria-current={active ? "page" : undefined}
                    >
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="ml-auto">
            <BlockMessengersLinks {brandData} showLabel={false} />
          </div>

          <div class="_header-contact-actions flex items-center gap-4">
            <Button href="#contact" text="Позвонить" variant="accent" />
            {/* Условие для отображения личного кабинета, нужно брать из админки */}
            {/* сейчас просто написано чтото рандомное */}
            {/* в MobileNav.astro тоже */}
            {brandData.main?.showPersonal && <Button href="#personal" text="Личный кабинет" variant="primary" />}
          </div>
        </div>

        <button
          type="button"
          class="flex h-10 w-10 items-center justify-center lg:hidden"
          @click="mobileNavOpen = true"
          aria-label="Открыть меню"
          aria-haspopup="dialog"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <MobileNav brandData={brandData} links={links} />
</div>
