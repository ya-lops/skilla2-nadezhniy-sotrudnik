---
import type { BrandData } from "@/types/brand";

import HeroMainFeatures from "../blocks/HeroMainFeatures.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;
---

<section
  class="hero grid grid-cols-[100%] min-h-[510px] md:min-h-[1000px] mt-[-100px] pt-[100px] lg:mt-[-100px] lg:pt-[100px] bg-hero-main-surface mx-2 lg:mx-5 rounded-[20px] md:rounded-[40px] overflow-clip"
  data-cmp="HeroMain"
>
  <div class="container relative h-full isolate">
    <div class="flex flex-col items-center justify-center h-full py-7 lg:py-14 text-center">
      <h1 class="flex flex-col uppercase my-auto py-25 lg:pb-[72px]">
        <span class="typo-h1">Грузчики,</span>
        <span class="typo-h1">Разнорабочие</span>
        <span class="typo-h1 text-text-primary-inverse">В {brandData.main.city_rod}</span>
      </h1>
      <div class="max-w-200">
        <HeroMainFeatures {brandData} />
      </div>

      <img class="absolute -z-1 max-lg:origin-top-left max-lg:scale-50 top-[-5%] left-[-5%] md:top-0 md:left-[15%]" src="/images/bg-hero-main-1.webp" alt=""/>
      <img class="absolute -z-1 max-lg:origin-right bottom-[15%] right-[-25%] max-lg:scale-80 md:bottom-[20%] md:right-0" src="/images/bg-hero-main-2.webp" alt=""/>
      <img class="absolute -z-1 max-lg:origin-bottom-left bottom-[5%] left-[-25%] max-lg:scale-80 md:bottom-0 md:left-[-10%]" src="/images/bg-hero-main-3.webp" alt=""/>
    </div>
  </div>
</section>
