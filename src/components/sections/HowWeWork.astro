---
import type { BrandData } from "@/types/brand";
import CtaCall from "../blocks/CtaCall.astro";

interface Props {
  brandData: BrandData;
  type: "column" | "grid";
}

const { brandData, type = "column" } = Astro.props;

const stepsImages = [
  {
    title: "Делайте заказ по телефону",
    image: "/images/how-1.webp",
  },
  {
    title: "Выставляем счет и вы оплачиваете",
    image: "/images/how-2.webp",
  },
  {
    title: "Качественно выполняем работу",
    image: "/images/how-3.webp",
  },
  {
    title: "Вы получаете документы",
    image: "/images/how-4.webp",
  },
];
---

<section class="py-8 md:py-10 lg:py-25 overflow-clip" data-cmp="HowWeWork">
  <div class="container">
    <h2 class="typo-h3 pb-10 lg:pb-25 uppercase text-center">Как мы работаем</h2>

    {
      type == "column" && (
        <div class="flex flex-col gap-10 max-w-240 mx-auto">
          {stepsImages.map((step: any, index: number) => {
            const isEven = index % 2 === 1;

            return (
              <div class={`_step flex max-md:flex-col gap-10 md:gap-25 w-full ${isEven ? "ml-auto flex-row-reverse" : ""}`}>
                <div class="flex flex-1 items-center gap-12">
                  <div class={`text-text-primary typo-h3`}>{index + 1}.</div>
                  <h3 class="typo-h6 text-balance">{step.title}</h3>
                </div>

                <div class="flex-1 shrink-0 relative grid place-items-center w-[min(27rem,100%)] justify-center aspect-430/218 rounded-4xl bg-[#F0F4F9]">
                  <img class={`absolute h-max max-h-[120%] pointer-events-none`} src={step.image} alt="" loading="lazy" />
                </div>
              </div>
            );
          })}
        </div>
      )
    }

    {
      type == "grid" && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {stepsImages.map((step: any, index: number) => {
            const isEven = index % 2 === 1;

            return (
              <div class={`_step grid grid-cols-1 md:grid-cols-2 max-lg:gap-5 p-4 md:p-5 lg:p-10 rounded-3xl bg-white`}>
                <div class="flex md:flex-col">
                  <div class="md:contents">
                    <h3 class="typo-h5-x2">{step.title}</h3>
                    <p class="mt-3 text-balance">{step.description}</p>
                  </div>

                  <div class={`md:mt-auto text-surface-primary-inverse typo-h3-x2`}>{index + 1}.</div>
                </div>

                <div class="grid place-items-center justify-self-center max-lg:max-w-[80%] aspect-square rounded-full bg-[#F2F4FA]">
                  <img class={`pointer-events-none`} src={step.image} alt="" loading="lazy" />
                </div>
              </div>
            );
          })}
        </div>
      )
    }

    <div class="mt-10 lg:mt-20">
      <CtaCall {brandData} />
    </div>
  </div>
</section>
