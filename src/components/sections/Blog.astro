---
import type { BrandData, BlogPost } from "@/types/brand";
import Button from "@/components/ui/Button.astro";

interface Props {
  brandData: BrandData;
  showLast?: boolean;
}

const { brandData, showLast = false } = Astro.props;

const currentPath = Astro.url?.pathname || "";
const isBlogPage = currentPath === "/blog";

const posts = showLast ? brandData.blogs?.slice(0, 3) : brandData.blogs;

const defaultCover = brandData.default.blog_default_cover;
---

<section class="py-8 md:py-10 lg:py-25" data-cmp="Blog" itemscope itemtype="https://schema.org/Blog">
  <meta itemprop="name" content={showLast ? "Последние статьи" : "Наш блог"} />

  <div class="container">
    <h2 class="mb-8 md:12 lg:mb-16 typo-h2" itemprop="name">
      {showLast ? "Последние статьи" : "Наш блог"}
    </h2>

    {
      posts?.length > 0 ? (
        <>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] lg:grid-cols-[repeat(auto-fill,minmax(400px,1fr))] gap-4">
            {posts.map((blogpost: BlogPost, index: number) => (
              <article itemscope itemtype="https://schema.org/BlogPosting" itemprop="blogPost">
                <meta itemprop="position" content={String(index + 1)} />
                <meta itemprop="datePublished" content={blogpost.date_create} />

                <a
                  class="flex flex-col items-start gap-4 text-left hover:[&_img]:scale-105 [&_img]:transition-transform"
                  href={`/blog/${blogpost.url}`}
                  itemprop="url"
                >
                  <div class="flex h-full aspect-1280/720 rounded-2xl overflow-clip">
                    {blogpost.cover ? (
                      <img
                        src={blogpost.cover}
                        alt={blogpost.title}
                        loading="lazy"
                        class="pointer-events-none h-full w-full object-cover"
                        itemprop="image"
                      />
                    ) : (
                      <img
                        src={defaultCover}
                        alt=""
                        class="pointer-events-none h-full w-full object-cover"
                        loading="lazy"
                        itemprop="image"
                      />
                    )}
                  </div>

                  <h3 class="px-4 typo-h4 text-left" itemprop="name">
                    {blogpost.title || "Запись блога"}
                  </h3>
                  <p class="px-4 typo-t3" itemprop="description">
                    {blogpost.subtitle || ""}
                  </p>
                  <div class="px-4 typo-label">{blogpost.date_create || ""}</div>
                </a>
              </article>
            ))}
          </div>

          {!isBlogPage && !showLast && (
            <div class="flex items-center justify-center gap-4 mt-16">
              <Button href="/blog" variant="secondary" arrow="right" text="Перейти в блог" />
            </div>
          )}
        </>
      ) : (
        <div>
          <p>Пока ничего нет</p>
        </div>
      )
    }
  </div>
</section>
