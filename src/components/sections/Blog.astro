---
import type { BrandData } from "@/types/brand";
import Button from "@/components/ui/Button.astro";

interface Props {
  brandData: BrandData;
  showLast?: boolean;
}

const { brandData, showLast = false } = Astro.props;

const currentPath = Astro.url?.pathname || "";
const isBlogPage = currentPath === "/blog";

const articles = showLast ? brandData.articles?.slice(0, 3) : brandData.articles;
---

<section class="py-8 md:py-10 lg:py-25" data-cmp="Blog">
  <div class="container">
    <h2 class="mb-8 md:12 lg:mb-16 typo-h3 uppercase text-center">Наш блог</h2>

    {
      articles?.length > 0 ? (
        <>
          <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] lg:grid-cols-[repeat(auto-fill,minmax(400px,1fr))] gap-4">
            {articles.map((blogpost: any) => (
              <article class="flex flex-col items-start gap-4 text-left">
                <a class="contents" href={`/blog/${blogpost.url}`}>
                  {blogpost.imagePreview ? (
                    <img src={blogpost.imagePreview} alt={`Превью-изображение для записи блога ${blogpost.title}`} loading="lazy" class="pointer-events-none"/>
                  ) : (
                    <div class="w-full rounded-2xl bg-gray-200 aspect-video" />
                  )}

                  <h3 class="px-4 typo-h4 text-left">{blogpost.title || "Запись блога"}</h3>
                  <p class="px-4 typo-t3">{blogpost.description || ""}</p>
                  <div class="px-4 typo-label">{blogpost.date_create || ""}</div>
                </a>
              </article>
            ))}
          </div>

          {!isBlogPage && !showLast && (
            <div class="flex items-center justify-center gap-4 mt-16">
              <Button href="/blog" variant="accent" arrow="right" text="Перейти в блог" />
            </div>
          )}
        </>
      ) : (
        <div>
          <p>Пока ничего нет</p>
        </div>
      )
    }
  </div>
</section>
