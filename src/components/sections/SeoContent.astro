---
import type { BrandData } from "@/types/brand";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.replace(/^\/+|\/+$/g, '').toLowerCase();

// Маппинг исключений
const pathMap: Record<string, string> = {
  '': 'index',
  'blog': 'blogs',
};

const contentUrl = pathMap[normalizedPath] || normalizedPath;

const pageContent = brandData.contents?.find(
  (content) => content.url.toLowerCase() === contentUrl
);

const hasContent = pageContent?.content?.trim();
---

{hasContent && (
  <section class="py-8 md:py-10 lg:py-20" data-cmp="SeoContent">
    <div class="container">
      <div class="max-w-none" set:html={pageContent?.content} />
    </div>
  </section>
)}