---
import type { BrandData } from "@/types/brand";

import HeroAboutFeatures from "../blocks/HeroAboutFeatures.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;
---

<section
  class="hero grid grid-cols-[100%] min-h-[510px] md:min-h-[880px] mt-[-133px] pt-[133px] lg:mt-[-172px] lg:pt-[172px] bg-hero-main-surface mx-2 lg:mx-5 rounded-[20px] md:rounded-[40px] overflow-clip"
  data-cmp="HeroAbout"
>
  <div class="container relative h-full isolate">
    <div class="flex flex-col items-center justify-center h-full py-14 text-center">
      <h1 class="flex flex-col typo-h1 uppercase my-auto pb-25 lg:pb-[132px]">
        <span class="">Фанатично контролируем <span class="text-text-primary-inverse">качество услуг</span></span>
      </h1>
      <div class="max-w-200">
        <HeroAboutFeatures {brandData} />
      </div>
    </div>

    <img class="absolute -z-1 max-lg:origin-top-left top-[-25%] left-[-25%] max-lg:scale-80 md:bottom-0 md:left-[0%]" src="/images/bg-hero-main-3.webp" alt=""/>
    <img class="absolute -z-1 max-lg:origin-right bottom-[15%] right-[-25%] max-lg:scale-80 md:bottom-[10%] md:right-0" src="/images/bg-hero-main-2.webp" alt=""/>
  </div>
</section>
