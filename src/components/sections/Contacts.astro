---
import type { BrandData } from "@/types/brand";

import BlockMessengersLinks from "@/components/blocks/BlockMessengersLinks.astro";
import Button from "@/components/ui/Button.astro";
import Map from "./Map.astro";
import PhoneReplacement from "../blocks/PhoneReplacement.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;

const reqs = [
  {
    label: "ИНН",
    value: brandData.default.inn,
  },
  {
    label: "КПП",
    value: brandData.default.kpp,
  },
  {
    label: "ОГРН",
    value: brandData.default.ogrn,
  },
  {
    label: "Юр. адрес",
    value: brandData.default.ur_address,
  },
  {
    label: "БИК",
    value: brandData.default.bik,
  },
  {
    label: "К/с",
    value: brandData.default.ks,
  },
  {
    label: "Банк",
    value: brandData.default.bank,
  },
  {
    label: "Р/с",
    value: brandData.default.rs,
  },
];
---

<section class="contacts py-8 md:py-10 lg:py-25" data-cmp="Contacts">
  <div class="container">
    <h1 class="typo-h3 mb-15 text-center uppercase">Контакты</h1>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_3fr] items-start gap-20">
      <div class="_contacts-info">
        <div class="flex flex-col items-start">
          <div class="_contacts-phones flex flex-col gap-10">
            {
              brandData.main.site_phone && (
                <PhoneReplacement
                  phone={brandData.main.site_phone}
                  replacementPhones={brandData.main.site_replacement_phones}
                  class="typo-h5 text-text-primary hover:underline!"
                />
              )
            }

            {
              brandData.main.site_phone2 && (
                <a class="typo-t1 text-text-primary hover:underline!" href={`tel:${brandData.main.site_phone2}`}>
                  {brandData.main.site_phone2}
                </a>
              )
            }

            <a class="typo-t3 text-text-secondary hover:underline!" href={`mailto:${brandData.main.site_email}`}
              >{brandData.main.site_email}</a
            >
          </div>

          <BlockMessengersLinks showLabel {brandData} />

          <div class="_contacts-hours mt-8 text-text-tertiary">
            Прием заказов: {brandData.main.site_work_time}
          </div>
        </div>
      </div>

      <div class="">
        <p class="typo-h5 mb-10">{brandData.default.name}</p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-10">
          {
            reqs
              ?.filter((item: any) => item.value)
              .map((item: any) => (
                <div class={`_reqs-item ${item.label == "Юр. адрес" ? "col-span-full order-first" : ""}`}>
                  <div class="_label typo-t4 text-text-secondary">{item.label}</div>
                  <div class="_value mt-2 typo-t3">{item.value}</div>
                </div>
              ))
          }
        </div>

        <Button href="https://api2.skilla.ru/api/site/details" variant="secondary" text="Скачать реквизиты" />
      </div>
    </div>

    <section class="mt-20">
      <p class="mb-4 typo-h5">{brandData.main.site_address}</p>

      <Map {brandData} simple />
    </section>
  </div>
</section>
