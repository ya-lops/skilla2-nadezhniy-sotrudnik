---
export interface Props {
  id: string;
  label: string;
  model?: string;
  unit?: string;
  step?: string;
  min?: string;
  max?: string;
  class?: string;
}

const { id, label, model = "", unit = "", step = "1", min = "0", max = "100", class: className = "" } = Astro.props;

const sliderStyle = `\`width: \${(((${model} - ${min}) / (${max} - ${min})) * 100)}%\``;
---

<div class="flex flex-col gap-6" data-cmp="CalcInput">
  <label for={id} class="text-text-primary-inverse typo-t4">{label}</label>

  <div class="relative w-full h-[6px] rounded-full bg-[#23488E]">
    <div class="h-full rounded-full bg-[#FF9A48] transition-all duration-150" x-bind:style={sliderStyle}></div>
    <input
      type="range"
      x-model.number={model}
      min={min}
      max={max}
      step={step}
      class="absolute top-1/2 left-0 -translate-y-1/2 w-full h-4 appearance-none bg-transparent cursor-pointer
          [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:w-[24px] [&::-webkit-slider-thumb]:h-[24px] [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-[radial-gradient(circle,#FFF_40%,#FF9A48_40%)] [&::-webkit-slider-thumb]:cursor-pointer [&::-webkit-slider-thumb]:border-none [&::-webkit-slider-thumb]:shadow-sm
          [&::-moz-range-thumb]:w-[24px] [&::-moz-range-thumb]:h-[24px] [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:bg-[#FF9A48] [&::-moz-range-thumb]:border-none [&::-moz-range-thumb]:cursor-pointer"
    />
  </div>

  <div class="flex items-baseline typo-h4">
    <input id={id} type="number" class="flex-1 outline-0 text-text-primary-inverse" x-model.number={model} step={step} min={min} max={max} />
    {unit && <span class="_unit text-text-primary-inverse/20 typo-h4">{unit}</span>}
  </div>
</div>
