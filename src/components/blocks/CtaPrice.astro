---
import type { BrandData } from "@/types/brand";
import { getGlobalMinPriceWithDiscount, getDiscountPercent } from "@/utils/price";
import Button from "../ui/Button.astro";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;

const discount = getDiscountPercent(brandData.main.adv_price_percent);

const { price, discountedPrice, showDiscount } = getGlobalMinPriceWithDiscount(brandData.services, discount);
---

<section class="flex flex-col gap-10 h-full text-cta-text overflow-clip" data-cmp="CtaPrice">
  <div class="flex flex-col gap-5 h-full p-5 lg:p-12.5 rounded-[20px]">
    <div class="">
      <p class="typo-t4">Стоимость наших сотрудников</p>
      <div class="mt-6 typo-h5">
        <span class="">от </span>
        <span class="typo-h3">
          {
            brandData.main?.adv_price && Number(brandData.main.adv_price) > 0
              ? brandData.main.adv_price
              : showDiscount
                ? discountedPrice
                : price
          }
        </span>
        <span class=""> ₽/час</span>
      </div>
    </div>
    <div class="ml-auto mr-20">
