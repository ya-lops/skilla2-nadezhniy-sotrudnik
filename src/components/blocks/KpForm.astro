---
import Button from "@/components/ui/Button.astro";
import FormInputKp from "@/components/ui/FormInputKp.astro";
import FormCheckbox from "@/components/ui/FormCheckbox.astro";
---

<div x-data="kpForm()" class="relative" data-cmp="KpForm">
  <form class="flex flex-col gap-10" @submit.prevent="submitForm()" novalidate>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-5">
      <FormInputKp id="kp-name" label="Имя" model="form.name" errorModel="errors.name" required />
      <FormInputKp id="kp-phone" type="tel" label="Телефон" model="form.phone" errorModel="errors.phone" required />
      <FormInputKp id="kp-email" type="email" label="Почта" model="form.email" errorModel="errors.email" required />
      <FormInputKp id="kp-inn" label="ИНН" model="form.inn" errorModel="errors.inn" required />
    </div>

    <div class="flex items-center gap-5">
      <Button
        tag="button"
        type="submit"
        variant="accent"
        :disabled="submitting || !form.agreement"
        :class="{ 'grayscale opacity-50 cursor-not-allowed!': !form.agreement }"
      >
        <span x-text="submitting ? 'Отправка...' : 'Получить КП'"></span>
      </Button>

      <div class="max-w-[20rem]">
        <FormCheckbox id="kp-agreement" model="form.agreement" errorModel="errors.agreement">
          <span class="text-text-primary-inverse"
            >Соглашаюсь с <a href="/policy" class="underline">политикой обработки персональных данных</a></span
          >
        </FormCheckbox>
      </div>
    </div>
  </form>

  <script is:inline>
    function kpForm() {
      return {
        form: {
          name: "",
          phone: "",
          email: "",
          inn: "",
          agreement: false,
        },
        errors: {
          name: false,
          phone: false,
          email: false,
          inn: false,
          agreement: false,
        },
        submitting: false,

        validate() {
          this.errors.name = this.form.name.trim().length < 2;

          const phoneDigits = this.form.phone.replace(/\D/g, "");
          this.errors.phone = phoneDigits.length !== 11;

          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          this.errors.email = !emailRegex.test(this.form.email.trim());

          const innDigits = this.form.inn.trim();
          this.errors.inn = !(innDigits.length === 10 || innDigits.length === 12);

          this.errors.agreement = !this.form.agreement;

          return !Object.values(this.errors).some(Boolean);
        },

        async submitForm() {
          if (!this.validate()) {
            return;
          }

          this.submitting = true;

          try {
            const response = await fetch("https://api2.skilla.ru/api/site/commercial-offer", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                phone: this.form.phone.replace(/\D/g, ""),
                inn: this.form.inn.trim(),
              }),
            });

            if (!response.ok) {
              throw new Error(`Ошибка сервера: ${response.status}`);
            }

            const data = await response.json();

            this.$dispatch("show-toast", {
              message: "Заявка отправлена!",
              type: "success",
            });

            // Очищаем форму после успешной отправки
            this.form = { name: "", phone: "", email: "", inn: "", agreement: false };
            // Сбрасываем ошибки
            this.errors = {
              name: false,
              phone: false,
              email: false,
              inn: false,
              agreement: false,
            };
          } catch (error) {
            console.error("Ошибка отправки формы:", error);

            this.$dispatch("show-toast", {
              message: "Произошла ошибка. Попробуйте позже",
              type: "error",
            });
          } finally {
            this.submitting = false;
          }
        },
      };
    }
  </script>
</div>
