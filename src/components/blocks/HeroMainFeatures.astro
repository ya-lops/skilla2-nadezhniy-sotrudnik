---
interface Props {
  brandData: any;
}

const { brandData } = Astro.props;

const features = [
  {
    text: "Фиксированная стоимость",
  },
  {
    text: "Удобная оплата",
  },
  {
    text: "Отсрочка при крупных заказах",
  },
  {
    text: "Работы по договору",
  },
  {
    text: "Работы по договору",
  },
];
---

<section class="flex flex-wrap justify-center gap-1.5 md:gap-2.5" data-cmp="HeroMainFeatures">
  {
    features.map((feature) => (
      <div class="typo-label py-2 px-3 rounded-full border border-text-primary font-semibold">
        <Fragment set:html={feature.text} />
      </div>
    ))
  }
</section>
