---
const features = [
  {
    text: "Низкие цены",
  },
  {
    text: "Трезвые рабочие в течение 1 часа",
  },
  {
    text: "Фиксированная стоимость",
  },
  {
    text: "Отсрочка при крупных заказах",
  },
  {
    text: "Удобная оплата",
  },
];
---

<section data-cmp="HeroFeatures">
  <ul>
    {
      features.map((feature) => (
        <li class="typo-t3 flex items-center gap-3 mb-2">
          <span class="w-2 h-2 shrink-0 rounded-full bg-accent"></span>
          <span class="text-text-primary-inverse" set:html={feature.text} />
        </li>
      ))
    }
  </ul>
</section>
