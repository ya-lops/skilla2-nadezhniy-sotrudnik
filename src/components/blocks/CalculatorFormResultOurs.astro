---
import type { BrandData } from "@/types/brand";

import CtaPrice from "./CtaPrice.astro";

interface Props {
  brandData: BrandData;
}
const { brandData } = Astro.props;
---

<div class="relative h-full rounded-[20px] lg:rounded-[30px] add-gradient-accent isolate" data-cmp="CalculatorFormResultOurs">
  <CtaPrice {brandData} />
</div>
