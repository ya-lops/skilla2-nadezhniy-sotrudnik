---
import Button from "../ui/Button.astro";
import BlockMessengersLinks from "./BlockMessengersLinks.astro";

import type { BrandData } from "@/types/brand";

interface Props {
  brandData: BrandData;
}

const { brandData } = Astro.props;
---

<div
  class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mt-20 p-6 lg:p-10 rounded-[20px] lg:rounded-[30px] add-gradient text-cta-text"
  data-cmp="CtaCall"
>
  <p class="typo-t2 max-w-[30rem] mr-auto">Свяжитесь с нами и мы расчитаем точную стоимость под ваши задачи</p>

  <div class="flex flex-col lg:flex-row gap-6">
    <BlockMessengersLinks showLabel class="text-text-secondary-inverse" {brandData} />
    <Button class="w-full lg:w-auto" href="#kp" variant="accent" text="Получить КП" />
  </div>
</div>
